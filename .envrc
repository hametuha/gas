# gcloud の設定（認証・アクティブプロジェクト）をこのリポジトリ配下に隔離する。
# 複数ワークスペース（hametuha / tarosky など）の取り違えを物理的に防ぐ。
# 初回のみ `direnv allow` が必要。以後このディレクトリに入ると自動で有効化される。
#
# 注意: clasp 自体はこの変数を読まない（clasp の認証は ~/.clasprc.json）。
#       ここでの隔離は Apps Script の裏側の GCP プロジェクトを gcloud で
#       操作する場合（API 有効化・OAuth 同意画面など）に効く。
export CLOUDSDK_CONFIG="$PWD/.gcloud"

# ローカル固有の秘匿値は .envrc.local に書いて source する（gitignore 済み）。
[ -f .envrc.local ] && source_env .envrc.local
